{
  "name": "ammen",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start": "expo start",
    "prebuild": "expo prebuild",
    "icons": "node scripts/build-icons.mjs",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web",
    "build:web:staging": "dotenv -e .env.staging.local -- expo export --platform web --output-dir dist",
    "deploy:web:staging": "npm run build:web:staging && firebase deploy --only hosting --project ammen-staging",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "node scripts/supabaseDbReset.mjs",
    "migrations:check": "node scripts/checkMigrations.mjs",
    "db:types": "node scripts/dbTypes.mjs --write",
    "db:types:check": "node scripts/dbTypes.mjs --check",
    "db:test": "node scripts/with-db-lock.mjs \"node scripts/dbTest.mjs\"",
    "db:test:rls": "node scripts/dbTest.mjs --only rls",
    "db:test:flows": "node scripts/dbTest.mjs --only flows",
    "db:test:streak": "node scripts/dbTest.mjs --only streak",
    "db:test:timezone": "node scripts/dbTest.mjs --only timezone",
    "db:test:bible": "node scripts/dbTest.mjs --only bible",
    "db:test:circles": "node scripts/dbTest.mjs --only circles",
    "db:test:plans": "node scripts/dbTest.mjs --only plans",
    "db:test:storage": "node scripts/dbTest.mjs --only storage",
    "db:test:social": "node scripts/dbTest.mjs --only social",
    "db:test:flags": "node scripts/dbTest.mjs --only flags",
    "db:test:push": "node scripts/dbTest.mjs --only push",
    "db:test:generation": "node scripts/dbTest.mjs --only generation",
    "db:test:email": "node scripts/dbTest.mjs --only email",
    "db:test:rescued": "node scripts/dbTest.mjs --only rescued",
    "db:test:scheduler": "node scripts/dbTest.mjs --only scheduler",
    "db:test:generation-races": "node scripts/dbTest.mjs --only generation-races",
    "db:test:generation-concurrency": "node scripts/dbTest.mjs --only generation-concurrency",
    "db:test:chunks": "node scripts/dbTest.mjs --only chunks",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run migrations:check && npm run db:test && npm run db:types:check",
    "e2e": "playwright test --project=chromium",
    "e2e:static": "node scripts/e2eStatic.mjs",
    "e2e:visual": "node scripts/e2eStatic.mjs --project=visual --project=visual-dark",
    "e2e:visual:update": "node scripts/e2eStatic.mjs --project=visual --project=visual-dark --update-snapshots",
    "doctor": "node scripts/doctor.mjs",
    "secrets:sync": "node scripts/secretsSync.mjs",
    "secrets:pull": "node scripts/secretsSync.mjs pull",
    "secrets:push": "node scripts/secretsSync.mjs push",
    "push:drain": "node scripts/pushDrain.mjs",
    "email:drain": "node scripts/emailDrain.mjs",
    "email:enqueue": "node scripts/emailEnqueue.mjs",
    "email:preview": "vitest run supabase/functions/_shared/emails/render.test.ts"
  },
  "dependencies": {
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo/log-box": "^56.0.12",
    "@expo/metro-runtime": "~56.0.18",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.111.0",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~56.0.4",
    "expo-blur": "~56.0.4",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.15",
    "expo-file-system": "~56.0.11",
    "expo-font": "~56.0.5",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.11",
    "expo-image-picker": "~56.0.22",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.11",
    "expo-localization": "~56.0.6",
    "expo-notifications": "~56.0.22",
    "expo-router": "~56.2.6",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.23",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "i18next": "^23.7.20",
    "lucide-react-native": "^1.28.0",
    "nativewind": "~4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^14.0.1",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@playwright/test": "^1.62.1",
    "@types/react": "~19.2.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~56.0.4",
    "eslint-config-prettier": "^10.1.2",
    "firebase-tools": "^15.26.0",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "sharp": "^0.35.3",
    "supabase": "^2.110.0",
    "tailwindcss": "^3.4.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "private": true
}
