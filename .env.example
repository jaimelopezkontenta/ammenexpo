EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# El dominio desde el que se sirve la web. Lo usan los enlaces que se comparten
# (`/p/…`, `/c/…`, `/i/…`) y las etiquetas Open Graph del HTML.
#
# **Sin esto, un build reparte enlaces a localhost.** En desarrollo se puede
# dejar vacío: el cliente cae al origen del navegador.
EXPO_PUBLIC_APP_URL=https://ammen.app

# RDY-13 — el id del proyecto EAS, para builds nativos y para que
# `getExpoPushTokenAsync()` (`core/notifications/push.ts`) funcione fuera de
# Expo Go. Lo lee `app.config.js`, nunca un valor puesto a mano en el
# repositorio: un `projectId` real identifica una cuenta de EAS concreta.
#
# **Vacío es un estado válido.** Sin login de EAS en este entorno no hay
# ningún `projectId` real que poner — `app.config.js` simplemente omite
# `extra.eas` cuando esto está vacío, y local/web sigue funcionando igual.
# Cuando alguien con acceso a EAS lo tenga: `eas init` o el dashboard de
# expo.dev lo dan; se pone aquí y en los secrets de CI, nunca en un commit.
# EAS_PROJECT_ID=
