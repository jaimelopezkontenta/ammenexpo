# AI_PROVIDER: "anthropic" (default, production) or "ollama" (local dev only).
AI_PROVIDER=anthropic

# Production. Set via: supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_API_KEY=

# Local dev fixture. A small local model validates plumbing, never quality.
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=gemma3:4b
