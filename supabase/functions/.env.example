# AI_PROVIDER: "anthropic" (default, production), "unsloth" (local model),
# or "fixture" (días fijos para CI/e2e; nunca producción).
AI_PROVIDER=anthropic

# Production. Set via: supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_API_KEY=

# Local dev fixture. A small local model validates plumbing, never quality.
# The model is served on the host (OpenAI-compatible API); the functions
# container reaches it through host.docker.internal. Defaults shown.
# UNSLOTH_URL=http://host.docker.internal:8888/v1
# UNSLOTH_MODEL=unsloth/Qwen3.8-27B-GGUF
# UNSLOTH_API_KEY=

# RDY-11 — send-intercession-push: kill switch. Absent/anything else means
# enabled; only the literal string "false" stops delivery without a redeploy.
# Set via: supabase secrets set PUSH_SENDER_ENABLED=false
# PUSH_SENDER_ENABLED=false
#
# Secreto de invocación de los drenajes (`x-ammen-invoker`). Si está definido,
# el sender exige el header con el mismo valor SIEMPRE. Si no lo está, solo se
# abre en local (`SUPABASE_URL` = http en kong, localhost, 127.0.0.1, [::1] o
# host.docker.internal: `_shared/invoker.ts`); en cualquier otro host responde
# 401 (fail-closed). En staging/producción es OBLIGATORIO, y el mismo valor va
# a Vault (`ammen_push_invoke_secret`) para que el programador de colas lo envíe.
# Nunca commitear el valor real.
# AMMEN_PUSH_INVOKE_SECRET=

# Correo (Resend). Nunca commitear las claves. El cliente Expo no las usa.
# EMAIL_SENDER_ENABLED=false
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=
# EMAIL_ALLOWLIST=jaime@ammen.app
# EMAIL_APP_ORIGIN=http://127.0.0.1:8081
# AMMEN_EMAIL_INVOKE_SECRET=   # igual que el de push: obligatorio fuera de local, y en Vault (`ammen_email_invoke_secret`)
